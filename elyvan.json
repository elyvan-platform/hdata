{
	"schemaVersion": 1,
	"name": "hdata",
	"shape": "monorepo",
	"scope": "@hdata",
	"generator": {
		"cli": "0.8.0"
	},
	"apps": [
		{
			"name": "web",
			"template": "nextjs",
			"path": "apps/web"
		},
		{
			"name": "api",
			"template": "fastify",
			"path": "apps/api",
			"blocks": ["database"]
		}
	],
	"packages": [
		{
			"name": "config",
			"block": "config",
			"path": "packages/config"
		},
		{
			"name": "domain",
			"block": "domain",
			"path": "packages/domain"
		},
		{
			"name": "api-client",
			"block": "api-client",
			"path": "packages/api-client"
		}
	],
	"blocks": [
		{
			"id": "ci",
			"target": "project"
		},
		{
			"id": "database",
			"target": "api"
		}
	],
	"ai": {
		"level": "standard",
		"agents": ["claude-code", "codex", "copilot"],
		"skills": ["elyvan-cli", "monorepo", "project-conventions"],
		"prompts": ["adr", "framing", "plan", "pr", "readiness", "spec"]
	}
}
