{
	"name": "@hdata/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --watch --env-file-if-exists=.env src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"check": "biome check . && node ../../packages/config/scripts/env-example.ts --check",
		"env:example": "node ../../packages/config/scripts/env-example.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"index:import": "node --experimental-strip-types src/archive/import-index-cli.ts",
		"extraction:enqueue": "node --env-file-if-exists=.env src/extraction/enqueue-cli.ts"
	},
	"dependencies": {
		"@hdata/domain": "workspace:*",
		"drizzle-orm": "catalog:",
		"fastify": "catalog:",
		"pg": "catalog:",
		"pg-boss": "catalog:",
		"zod": "catalog:",
		"exceljs": "catalog:"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:",
		"@hdata/config": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"drizzle-kit": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
