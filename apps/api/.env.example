# Runtime mode
NODE_ENV=development

# Interface the server binds to
HOST=0.0.0.0

# Port the server listens on
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgres://hdata:hdata@localhost:5432/hdata

# Digitarq catalog endpoint returning the fonds catalog as JSON (optional)
DIGITARQ_CATALOG_URL=

# Official reference of the fonds to import
DIGITARQ_FONDS_REFERENCE=PT/ADPRT/PRQ/PAMT38

# Per-request timeout when querying Digitarq, in milliseconds
DIGITARQ_TIMEOUT_MS=10000

# Bearer token that authorizes POST /catalog/refresh (optional; unset disables it)
CATALOG_REFRESH_TOKEN=

# JSON array of {"token","id","role"} editorial actors; role is editor, reviewer, publisher or admin (optional; unset disables /review)
EDITORIAL_ACTORS=

# Commit reported by /version (optional)
COMMIT_SHA=
