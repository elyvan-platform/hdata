{
	"name": "hdata",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"postinstall": "node -e \"require('node:child_process').spawnSync('elyvan',['doctor'],{stdio:'inherit',shell:process.platform==='win32'})\"",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check": "biome check . && turbo run check",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"turbo": "catalog:"
	}
}
